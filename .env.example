# Copy this file to .env and fill in ONE key. Never commit .env.
# With no key, the app runs in MOCK mode with canned AI results (good for building UI and as a demo fallback).

# Option A: Claude (Anthropic)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Option B: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

PORT=3000
