# Copy this file to .env and fill in ONE key. Never commit .env.
# With no key, the app runs in MOCK mode with canned AI results (good for building UI and as a demo fallback).

# Option A: Claude (Anthropic)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.8-flash

# Option B: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

PORT=3000
