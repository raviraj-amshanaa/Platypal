# Copy this file to .env and fill in ONE key. Never commit .env.
# With no key, the app runs in MOCK mode with canned AI results (good for building UI and as a demo fallback).

# Option A: Claude (Anthropic)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.8-flash

# Option B: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

PORT=3000
# Copy this file to .env and fill in your key. Never commit .env.
# With no key, the app runs in MOCK mode with sample AI results (good for building UI and as a demo fallback).

# Recommended: Google Gemini (free key at aistudio.google.com)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.1-flash-lite

# Option: Claude (Anthropic) - needs paid API credits
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Give up and use sample results if the AI takes longer than this (milliseconds)
AI_TIMEOUT_MS=60000

PORT=3000